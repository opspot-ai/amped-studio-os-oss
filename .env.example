# Local runtime only. Keep real values in your shell or secret manager.
ENGINE_MODE=local
ENGINE_ROOT=.
ENGINE_DB_PATH=./data/engine.db
ENGINE_DASHBOARD_URL=http://127.0.0.1:3210
ENGINE_WORKSPACE_ID=workspace_local

# Optional account-backed services. Invite links are copied manually; no email is sent.
DATABASE_URL=
OPSPOT_DATABASE_SCHEMA=public
OPSPOT_APP_ORIGIN=http://127.0.0.1:3210
OPSPOT_STUDIO_ORIGIN=http://127.0.0.1:4173
OPSPOT_PLATFORM_ADMIN_SUBJECTS=
AUTH_RATE_LIMIT_SECRET=
# Build-time feature flag. Keep disabled until an identity provider is configured.
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=0

# Optional BYO dispatcher setting. Do not put credentials in this file.
ENGINE_DISPATCH_ADAPTER=

# Optional BYO execution providers. Leave each provider group entirely empty when unused.
OPENAI_API_KEY=
OPENAI_CEO_MODEL=gpt-5.6-terra
OPENAI_INITIATIVE_MODEL=gpt-5.6-terra
OPENAI_WEB_SEARCH_COST_CENTS=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Live self-serve stays off until every plan-specific price below is configured.
GTM_SELF_SERVE_CHECKOUT_ENABLED=0
# Required legacy fallback while checkout loads its provider dependencies.
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_SCALE=
STRIPE_TRIAL_BYPASS_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_ACQUISITION_FROM=
RESEND_ACQUISITION_TO=
RESEND_CONNECTOR_WORKSPACE_ID=
RESEND_CONNECTOR_COMPANY_ID=
RESEND_OWNED_INBOUND_RECIPIENT=

# Product-owned offer and digital fulfillment keys: base64url-encoded 32-byte values.
PUBLIC_OFFER_SLUG_KEY=
PUBLIC_OFFER_SLUG_KEY_ID=
DIGITAL_ACCESS_ROOT_KEY=
DIGITAL_ACCESS_KEY_ID=

# Optional exact server-bound generic webhook and bounded analytics signer.
GENERIC_WEBHOOK_SIGNER=
GENERIC_WEBHOOK_SECRET=
GENERIC_WEBHOOK_WORKSPACE_ID=workspace_local
GENERIC_WEBHOOK_COMPANY_ID=

# Explicit test-only access and real-provider smoke gates. Never enable fixture access in Cloud.
ENGINE_ALLOW_FIXTURE_PROVIDERS=0
OPSPOT_RUN_REAL_PROVIDER_SMOKE=0
BYO_STRIPE_PAYMENT_INTENT_ID=
