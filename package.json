{
  "name": "amped-studio-os",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "description": "Agent-native company runtime for evidence-backed launch, execution, and replanning",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.15.1"
  },
  "scripts": {
    "build": "pnpm schema:export && pnpm --filter @amped-studio-os/control build && pnpm --filter @amped-studio-os/studio build && pnpm --filter @amped-studio-os/admin build && tsc -p tsconfig.build.json",
    "dev": "pnpm --parallel --filter @amped-studio-os/control --filter @amped-studio-os/worker dev",
    "dev:control": "pnpm --filter @amped-studio-os/control dev",
    "dev:admin": "pnpm --filter @amped-studio-os/admin dev",
    "dev:studio": "pnpm --filter @amped-studio-os/studio dev",
    "dev:worker": "pnpm --filter @amped-studio-os/worker dev",
    "start": "pnpm --parallel --filter @amped-studio-os/control --filter @amped-studio-os/worker start",
    "test": "vitest run && pnpm test:control-auth && pnpm test:control-usage && pnpm test:control-proof",
    "test:control-auth": "TSX_TSCONFIG_PATH=apps/control/tsconfig.test.json tsx apps/control/app/google-auth-render.test.tsx",
    "test:control-usage": "TSX_TSCONFIG_PATH=apps/control/tsconfig.test.json tsx apps/control/app/usage-view-render.test.tsx",
    "test:control-proof": "TSX_TSCONFIG_PATH=apps/control/tsconfig.test.json tsx apps/control/app/proof/page.test.tsx",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm --filter @amped-studio-os/studio typecheck && pnpm --filter @amped-studio-os/admin typecheck",
    "lint": "eslint .",
    "schema:export": "tsx scripts/export-schema.ts",
    "setup": "tsx scripts/setup.ts",
    "quickstart:check": "pnpm setup && pnpm engine:doctor",
    "quickstart": "pnpm quickstart:check && pnpm build && tsx scripts/start-local.ts",
    "doctor": "tsx scripts/doctor.ts",
    "engine:doctor": "tsx scripts/doctor.ts",
    "cli": "tsx apps/cli/src/index.ts",
    "mcp": "tsx apps/mcp/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "cloud:backup": "tsx scripts/cloud-backup-restore.ts backup",
    "cloud:restore": "tsx scripts/cloud-backup-restore.ts restore-verify",
    "check:corruption": "tsx scripts/corruption-check.ts",
    "check:contrast": "node scripts/check-theme-contrast.mjs",
    "check:routes": "node scripts/check-route-drift.mjs",
    "verify": "pnpm check:contrast"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "26.1.1",
    "eslint": "9.39.2",
    "next": "16.2.12",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vitest": "4.1.10"
  }
}
